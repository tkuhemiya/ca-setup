LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Used by observability/export.mjs on a laptop (agent machines get the host from tracing/langfuse.json)
LANGFUSE_BASE_URL=
CURSOR_TOKEN=
# team (default, needs a team key) or personal
CURSOR_ENVIRONMENT_OWNER=
# A secret listed in repos/<repo>/environment.json is read from <REPO>_<NAME>, for example:
# TYPST_EDITOR_DATABASE_URL=
# Optional. Cursor Admin API key (Enterprise only) for tokens and cost in observability/enrich.mjs
CURSOR_ADMIN_API_KEY=
